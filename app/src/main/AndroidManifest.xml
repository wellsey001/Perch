<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather widget: coarse location + Open-Meteo forecast -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar widget -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Perch's own wallpapers -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Optional: lets Perch read your current wallpaper so the glass can frost it -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Swipe down for notifications -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Photo frame widget, when set to use this phone's photos -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Contacts in search (asked for when you choose it) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Uninstall from the long-press menu -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Perch">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_name"
            android:taskAffinity="com.wellsey.perch.settings"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Perch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets Clack read Perch's accent colour so the keyboard matches. Colour only, nothing personal. -->
        <provider
            android:name=".ThemeProvider"
            android:authorities="com.wellsey.perch.theme"
            android:exported="true" />

        <service
            android:name=".Notifier"
            android:exported="true"
            android:label="Perch notification dots"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".LockService"
            android:exported="true"
            android:label="@string/lock_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
